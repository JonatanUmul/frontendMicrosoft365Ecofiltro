<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>f6ff57a5-5938-4654-8d80-4bd7830d6a23</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Tu Empresa</ProviderName>
  <DefaultLocale>es-GT</DefaultLocale>
  <DisplayName DefaultValue="Firmas Automaticas 365"/>
  <Description DefaultValue="Inserta automaticamente la firma corporativa al redactar correos en Outlook."/>
  <IconUrl DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com"/>
  <AppDomains>
    <AppDomain>https://frontendmicrosoft365ecofiltro.onrender.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/src/taskpane/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
                    xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
                      xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Autorun.Url" lifetime="short">
              <Override type="javascript" resid="AutorunJs.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="Signature.Group">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="Signature.InsertButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="Autorun.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/src/taskpane/taskpane.html"/>
          <bt:Url id="Autorun.Url" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/src/autorun/autorun.html"/>
          <bt:Url id="AutorunJs.Url" DefaultValue="https://frontendmicrosoft365ecofiltro.onrender.com/outlook-signature-addin/src/autorun/autorun.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Firmas"/>
          <bt:String id="Button.Label" DefaultValue="Insertar firma"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Inserta o actualiza la firma corporativa del usuario."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
